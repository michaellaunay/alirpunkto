<div metal:use-macro="load: layout.pt">
    <div metal:fill-slot="content">
        <h1 tal:define="is_own_profile python: member is not None and accessed_member is not None and (getattr(member, 'oid', None) == getattr(accessed_member, 'oid', accessed_member))"
            tal:content="python: _('your_profile_title') if is_own_profile else _('modify_member_title')"
            i18n:domain="alirpunkto">Your profile</h1>
        <!-- Member avatar (issue #150): visible on any consulted profile;
             upload and removal only on one's own. -->
        <div class="container member-avatar" i18n:domain="alirpunkto"
             tal:condition="accessed_member"
             tal:define="is_self python: member is not None and getattr(member, 'oid', None) == getattr(accessed_member, 'oid', None)">
            <img tal:attributes="src python: request.route_url('member_avatar') + '?oid=' + str(getattr(accessed_member, 'oid', ''))"
                 tal:condition="python: getattr(accessed_member, 'oid', None)"
                 alt="Avatar" class="avatar" width="128" onerror="this.style.display='none'" />
            <form method="POST" enctype="multipart/form-data"
                  tal:condition="is_self"
                  tal:attributes="action request.route_url('avatar_upload')">
                <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                <p class="explanation" tal:content="_('avatar_format_description')">JPEG only</p>
                <input type="file" name="avatar" accept=".jpg,.jpeg" />
                <input type="submit" name="upload" tal:attributes="value _('avatar_upload_button')" />
                <input type="submit" name="remove" tal:attributes="value _('avatar_remove_button')" />
            </form>
        </div>
        <!-- Resignation entry point (spec "Démissionner"): only on one's own profile. -->
        <div class="container deactivate-account" i18n:domain="alirpunkto"
             tal:condition="python: member is not None and accessed_member is not None and getattr(member, 'oid', None) == getattr(accessed_member, 'oid', None)">
            <a tal:attributes="href request.route_url('unsubscribe')" tal:content="_('deactivate_account_link')">Deactivate my account</a>
        </div>
        <!-- Read-only card administrators see of another member (issue #149). -->
        <div class="container admin-member-card" i18n:domain="alirpunkto"
             tal:define="admin_view admin_view | nothing"
             tal:condition="admin_view">
            <h2 tal:content="_('member_admin_card_title')">Member card</h2>
            <img tal:condition="admin_view/has_avatar"
                 tal:attributes="src python: request.route_url('member_avatar') + '?oid=' + str(admin_view['oid'])"
                 alt="avatar" width="96" height="96" />
            <dl>
                <dt tal:content="_('pseudonym_label')">Pseudonym</dt>
                <dd tal:content="admin_view/pseudonym">pseudonym</dd>
                <dt tal:content="_('description_label')">Profile text</dt>
                <dd tal:content="admin_view/description | default">—</dd>
                <dt tal:content="_('user_number_label')">User number</dt>
                <dd tal:content="admin_view/oid">oid</dd>
                <dt tal:content="_('role_label')">Role</dt>
                <dd tal:content="python:_(admin_view['role_i18n'])">role</dd>
                <dt tal:content="_('cooperative_behaviour_mark_label')">Cooperative Behaviour Mark</dt>
                <dd tal:content="admin_view/cooperative_behaviour_mark | default">—</dd>
                <dt tal:content="_('cooperative_behaviour_mark_update_label')">Last CBM update</dt>
                <dd tal:content="admin_view/cooperative_behaviour_mark_update | default">—</dd>
                <tal:departure condition="admin_view/departure_date">
                    <dt tal:content="_('departure_date_label')">Departure date</dt>
                    <dd tal:content="admin_view/departure_date">date</dd>
                    <dt tal:content="_('departure_reason_label')">Departure reason</dt>
                    <dd tal:content="admin_view/departure_reason | default">—</dd>
                </tal:departure>
            </dl>
        </div>
        <div class="container" i18n:domain="alirpunkto" tal:condition="not accessed_member">
            <form method="POST">
                <div> <!-- CSRF Token Field -->
                    <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                </div>
                <label for="accessed_member_oid" i18n:translate="select_member_oid_label">Select the member</label>
                <select id="accessed_member_oid" name="accessed_member_oid" required>
                    <option value="" disabled selected i18n:translate="select_member_placeholder">Select a member</option>
                    <option tal:repeat="(item_key, item_value) items"
                        tal:define="items accessed_members.items()"
                        tal:attributes="value item_key"
                        tal:condition="items"
                        tal:content="item_value"></option>
                </select>
                <input type="submit" name="submit" value="Submit" i18n:attributes="value submit_button">
            </form>
        </div>
        <!-- Issue #55: the read-only facts outside the form — the groups
             one belongs to, and the role for a Cooperator. -->
        <div class="container own-member-panel" i18n:domain="alirpunkto"
             tal:define="own_view own_view | nothing"
             tal:condition="own_view">
            <dl>
                <dt tal:content="_('your_groups_label')">Your groups</dt>
                <dd>
                    <span tal:repeat="entry own_view/groups"
                          class="member-group"
                          tal:content="python: _(entry[1]) if entry[1] else entry[0]">group</span>
                </dd>
                <tal:role condition="own_view/role_i18n">
                    <dt tal:content="_('role_label')">Role</dt>
                    <dd tal:content="python:_(own_view['role_i18n'])">role</dd>
                </tal:role>
            </dl>
        </div>
        <div tal:condition="form" class="member-form">
            <!-- Issue #123: the introduction of the specification. -->
            <p i18n:translate="your_profile_introduction">On this page, you can view your own profile, and modify some of its elements. In order to modify an item, simply replace the existing content of the field with the new content of your choosing.</p>
            <span tal:replace="structure form">Form Content</span>
        </div>
        <div tal:condition="exists:message" tal:omit-tag="">

            <div class="message">
                <p tal:content="message">The message here</p>
            </div>
        </div>
        <div tal:condition="exists:error" tal:omit-tag="">
            <div class="error">
                <p tal:content="error">Error message here</p>
            </div>
            <div class="error" tal:condition="exists:error_details">
                <p tal:content="error_details">Error details message here</p>
            </div>
        </div>
    </div>
</div>
