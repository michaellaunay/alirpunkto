<div metal:use-macro="load: layout.pt">
    <div metal:fill-slot="content">
        <h1 i18n:translate="modify_member_title">Consult or modify the member datas ?</h1>
        <!-- Member avatar (issue #150): visible on any consulted profile;
             upload and removal only on one's own. -->
        <div class="container member-avatar" i18n:domain="alirpunkto"
             tal:condition="accessed_member"
             tal:define="is_self python: member is not None and getattr(member, 'oid', None) == getattr(accessed_member, 'oid', None)">
            <img tal:attributes="src python: request.route_url('member_avatar') + '?oid=' + str(getattr(accessed_member, 'oid', ''))"
                 tal:condition="python: getattr(accessed_member, 'oid', None)"
                 alt="Avatar" class="avatar" width="128" onerror="this.style.display='none'" />
            <form method="POST" enctype="multipart/form-data"
                  tal:condition="is_self"
                  tal:attributes="action request.route_url('avatar_upload')">
                <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                <p class="explanation" tal:content="_('avatar_format_description')">JPEG only</p>
                <input type="file" name="avatar" accept=".jpg,.jpeg" />
                <input type="submit" name="upload" tal:attributes="value _('avatar_upload_button')" />
                <input type="submit" name="remove" tal:attributes="value _('avatar_remove_button')" />
            </form>
        </div>
        <!-- Resignation entry point (spec "Démissionner"): only on one's own profile. -->
        <div class="container deactivate-account" i18n:domain="alirpunkto"
             tal:condition="python: member is not None and accessed_member is not None and getattr(member, 'oid', None) == getattr(accessed_member, 'oid', None)">
            <a tal:attributes="href request.route_url('unsubscribe')" tal:content="_('deactivate_account_link')">Deactivate my account</a>
        </div>
        <div class="container" i18n:domain="alirpunkto" tal:condition="not accessed_member">
            <form method="POST">
                <div> <!-- CSRF Token Field -->
                    <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                </div>
                <label for="accessed_member_oid" i18n:translate="select_member_oid_label">Select the member</label>
                <select id="accessed_member_oid" name="accessed_member_oid" required>
                    <option value="" disabled selected i18n:translate="select_member_placeholder">Select a member</option>
                    <option tal:repeat="(item_key, item_value) items"
                        tal:define="items accessed_members.items()"
                        tal:attributes="value item_key"
                        tal:condition="items"
                        tal:content="item_value"></option>
                </select>
                <input type="submit" name="submit" value="Submit" i18n:attributes="value submit_button">
            </form>
        </div>
        <div tal:condition="form" class="member-form">
            <p i18n:translate="modify_member_fill_form">Please fill the fields</p>
            <span tal:replace="structure form">Form Content</span>
        </div>
        <div tal:condition="exists:message" tal:omit-tag="">

            <div class="message">
                <p tal:content="message">The message here</p>
            </div>
        </div>
        <div tal:condition="exists:error" tal:omit-tag="">
            <div class="error">
                <p tal:content="error">Error message here</p>
            </div>
            <div class="error" tal:condition="exists:error_details">
                <p tal:content="error_details">Error details message here</p>
            </div>
        </div>
    </div>
</div>
