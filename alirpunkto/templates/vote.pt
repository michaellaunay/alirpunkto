<!DOCTYPE html>
<html xmlns:metal="http://xml.zope.org/namespaces/metal"
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    xmlns:tal="http://xml.zope.org/namespaces/tal">
<div metal:use-macro="load: layout.pt">
    <div metal:fill-slot="content">
        <div class="container" i18n:domain="alirpunkto">
            <h1 i18n:translate="vote_msg">Welcome to the identity verification of <tal:var i18n:name="domain_name">${domain_name}</tal:var>.</h1>
            <div tal:condition="not: exists:error"
                tal:define="localizer request.localizer">
                <div>
                    <!-- welcome_voter carries structured HTML (paragraphs and an
                         ordered list, issue #207), so it is rendered as structure
                         through _(), which also interpolates the candidate name
                         and, via SITE_INFORMATION_MAPPING, the site variables.
                         Chameleon evaluates dollar-brace expressions even inside
                         HTML comments, so never write one literally here
                         (issue #243). -->
                    <div tal:condition="not registered_vote"
                         tal:replace="structure _('welcome_voter', {'name': candidature.data.fullname})">
                        You are about to vote on whether to accept or reject the application of
                        a candidate. Their admission to the portal depends on your decision.
                    </div>
                    <p tal:condition="registered_vote" i18n:translate="vote_success">
                        <span i18n:name="vote"
                            tal:content="python:localizer.translate(_(VotingChoice[vote].value))">
                            ${VotingChoice[vote].value}
                        </span>
                    </p>
                </div>
                <div>
                    <ul>
                        <tal:block tal:repeat="field python:candidature.data.iter_attributes()">
                            <!-- Only the identity data the verifiers compare with the ID document
                                 is displayed (issue #206, GDPR data minimisation). -->
                            <li tal:condition="python:field[0] in ['fullname', 'fullsurname', 'nationality', 'birthdate']">
                                <span tal:content="python:field[0]">Field Name</span>
                                <span tal:content="python:field[1]">Field Value</span>
                            </li>
                        </tal:block>
                    </ul>
                </div>
                <h3 i18n:translate="voting_header">Vote for the Candidature</h3>
                <form method="POST" action="${request.route_url('vote')}"
                    tal:define="votingChoices python:VotingChoice.get_names()">
                    <div> <!-- CSRF Token Field -->
                        <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                    </div>
                    <fieldset>
                        <legend i18n:translate="vote_legend">Choose your vote:</legend>
                        <ul>
                            <li tal:repeat="choice votingChoices">
                                <!-- Radio button for each voting choice -->
                                <input type="radio" name="vote" 
                                    tal:attributes="value choice; 
                                                    id 'vote_' + choice; 
                                                    checked 'checked' if repeat.choice.index == 0 else None" />
                                <label tal:attributes="for 'vote_' + choice"
                                    tal:content="python:localizer.translate(_(VotingChoice[choice].value))">
                                    ${VotingChoice[choice].value}
                                </label>
                            </li>
                        </ul>
                        <input type="submit" value="Submit" name="submit"
                            title="Click to submit your vote."
                            i18n:attributes="title submit_vote_title; value submit_button" />
                    </fieldset>
                </form>
            </div>
            <div tal:condition="exists:error" tal:omit-tag="">
                <div class="error" tal:condition="exists:error">
                    <p tal:content="error">Error message here</p>
                </div>
                <div class="error" tal:condition="exists:error_details">
                    <p tal:content="error_details">Error details message here</p>
                </div>
            </div>
        </div>
    </div>
</div>
</html>
