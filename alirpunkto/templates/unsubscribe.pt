<div metal:use-macro="load: layout.pt">
    <div metal:fill-slot="content">
        <h1 tal:content="_('deactivate_account_link')">Deactivate my account</h1>
        <div class="container" i18n:domain="alirpunkto">
            <div tal:condition="error" class="error-message" tal:content="error">Error</div>
            <div tal:condition="success" class="success-message" tal:content="success">Success</div>
            <tal:member condition="python: member is not None and not pending and not error">
                <div class="explanation">
                    <p tal:content="_('unsubscribe_intro')">Intro</p>
                    <ul>
                        <li tal:content="_('unsubscribe_implication_no_login')">i1</li>
                        <li tal:content="_('unsubscribe_implication_quarantine')">i2</li>
                        <li tal:content="_('unsubscribe_implication_confirmation_link')">i3</li>
                    </ul>
                </div>
                <form method="POST">
                    <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                    <input type="submit" name="confirm" tal:attributes="value _('unsubscribe_request_button')" />
                </form>
            </tal:member>
            <tal:pending condition="pending">
                <p tal:content="_('unsubscribe_pending_message')">Pending</p>
                <form method="POST" tal:attributes="action request.route_url('unsubscribe_cancel')">
                    <input type="hidden" name="csrf_token" tal:attributes="value request.session.get_csrf_token()" />
                    <input type="submit" name="cancel" tal:attributes="value _('unsubscribe_cancel_button')" />
                </form>
            </tal:pending>
        </div>
    </div>
</div>
