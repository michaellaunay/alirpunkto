dn: cn=alirpunktoPerson,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: alirpunktoPerson
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.1
  NAME 'nationality' 
  DESC 'Nationality of the individual' 
  EQUALITY caseIgnoreMatch 
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{40} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.2
  NAME 'birthdate' 
  DESC 'Birth date of the individual in ISO 8601 format'
  EQUALITY caseExactMatch
  ORDERING caseExactOrderingMatch
  SUBSTR caseExactSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.3
  NAME 'secondLanguage' 
  DESC 'Second language of the individual' 
  EQUALITY caseIgnoreMatch 
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{40} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.4
  NAME 'cooperativeBehaviourMark' 
  DESC 'Cooperative Behaviour Mark, expected to be a floating-point number stored as a string'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{127} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.5
  NAME 'cooperativeBehaviourMarkUpdate'
  DESC 'Last Update Time of the Cooperative Behaviour Mark' 
  EQUALITY caseIgnoreMatch 
  ORDERING caseExactOrderingMatch
  SUBSTR caseExactSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.6
  NAME 'thirdLanguage' 
  DESC 'Third Interaction Language' 
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.7
  NAME 'isActive' 
  DESC 'Indicates if the user is active' 
  EQUALITY booleanMatch 
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.8
  NAME 'numberSharesOwned' 
  DESC 'Number of Shares Owned' 
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 )
  # Integer Syntax
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.9
  NAME 'dateEndValidityYearlyContribution' 
  DESC 'End Date of Validity for Yearly Contribution in ISO 8601 format'
  EQUALITY caseExactMatch
  ORDERING caseExactOrderingMatch
  SUBSTR caseExactSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.10
  NAME 'IBAN'
  DESC 'IBAN bank account number of the individual'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{34} SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.11
  NAME 'uniqueMemberOf'
  DESC 'DN of the group to which the user belongs'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.12
  NAME 'dateErasureAllData'
  DESC 'Date by which the user data should be erased'
  EQUALITY caseExactMatch
  ORDERING caseExactOrderingMatch
  SUBSTR caseExactSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.13
  NAME 'eMailDestinationCooperator1'
  DESC 'E-mail address of destination Cooperator 1 of the focal Cooperator (Shared Directory provision, statutes 5.3.1, issue #110)'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.14
  NAME 'eMailDestinationCooperator2'
  DESC 'E-mail address of destination Cooperator 2 of the focal Cooperator (Shared Directory provision, statutes 5.3.1, issue #110)'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.15
  NAME 'eMailDestinationCooperator3'
  DESC 'E-mail address of destination Cooperator 3 of the focal Cooperator (Shared Directory provision, statutes 5.3.1, issue #110)'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.16
  NAME 'eMailDestinationCooperator4'
  DESC 'E-mail address of destination Cooperator 4 of the focal Cooperator (Shared Directory provision, statutes 5.3.1, issue #110)'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.17
  NAME 'eMailDestinationCooperator5'
  DESC 'E-mail address of destination Cooperator 5 of the focal Cooperator (Shared Directory provision, statutes 5.3.1, issue #110)'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.61000.1.18
  NAME 'cipheredPersonalData'
  DESC 'Ciphered block (< 512 characters) of the focal Cooperator personal data for the Shared Directory (statutes 5.3.1, issue #110)'
  EQUALITY caseExactMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{512}
  SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.61000.2.2.1
  NAME 'alirpunktoPerson'
    DESC 'AlirPunkto specific person object class' 
  SUP top 
  AUXILIARY 
    MUST ( isActive )
    MAY ( nationality $ birthdate $ secondLanguage $ thirdLanguage $ 
        cooperativeBehaviourMark $ cooperativeBehaviourMarkUpdate $ 
        numberSharesOwned $ dateEndValidityYearlyContribution $ IBAN $
        uniqueMemberOf $ dateErasureAllData $
        eMailDestinationCooperator1 $ eMailDestinationCooperator2 $
        eMailDestinationCooperator3 $ eMailDestinationCooperator4 $
        eMailDestinationCooperator5 $ cipheredPersonalData )
  )
