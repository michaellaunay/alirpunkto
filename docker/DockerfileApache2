# Fourth audit pass (2026-08-01, P1): base pinned by digest — a
# mutable tag is a supply-chain risk (multi-arch manifest list).
FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

# Sixth audit pass (2026-08-01, §11.3) — opt-in strict reproducibility:
# when set (e.g. 20260801T000000Z), every apt operation resolves against
# snapshot.ubuntu.com at that instant instead of the moving archive
# (deb822 `Snapshot:` field, verified on noble's apt 2.8.3). Off by
# default; pass ALIRPUNKTO_UBUNTU_SNAPSHOT through compose to enable.
ARG UBUNTU_SNAPSHOT=""
RUN if [ -n "${UBUNTU_SNAPSHOT}" ]; then \
        sed -i "s|^Types:|Snapshot: ${UBUNTU_SNAPSHOT}\nTypes:|" /etc/apt/sources.list.d/ubuntu.sources \
        && grep -q "^Snapshot: ${UBUNTU_SNAPSHOT}$" /etc/apt/sources.list.d/ubuntu.sources; \
    fi

# Avoid interactive apt prompts during image build.
ENV DEBIAN_FRONTEND=noninteractive

# Install Apache, Certbot, and the small runtime needed to render the vhost template.
RUN apt-get update && apt-get install -y --no-install-recommends \
    apache2 \
    certbot \
    gettext-base \
    python3-certbot-apache \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Enable the Apache modules required for TLS termination and reverse proxying.
RUN a2enmod ssl rewrite proxy proxy_http headers remoteip

# A6: global hardening that cannot live in a <VirtualHost> (server-config context):
# hide the Apache/OS version banner and disable the TRACE method.
RUN printf 'ServerTokens Prod\nServerSignature Off\nTraceEnable Off\n' \
        > /etc/apache2/conf-available/hardening.conf \
    && a2enconf hardening

# Copy the generic site template used by the container entrypoint.
COPY etc/apache2/sites-available/alirpunkto.conf.template /templates/alirpunkto.conf.template
COPY start_apache2.sh /usr/local/bin/start_apache2.sh

# Make the startup script executable and disable the default site.
RUN chmod +x /usr/local/bin/start_apache2.sh \
    && a2dissite 000-default.conf

# Expose HTTP and HTTPS.
EXPOSE 80 443

# Persist Let's Encrypt material and Apache logs.
VOLUME ["/etc/letsencrypt", "/var/lib/letsencrypt", "/var/log/apache2"]

# Start Apache through the custom entrypoint.
ENTRYPOINT ["/usr/local/bin/start_apache2.sh"]
