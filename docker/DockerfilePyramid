# Fourth audit pass (2026-08-01, P1) — multi-stage build:
# - the base image is pinned by digest (a mutable tag is a supply-chain
#   risk; this is the multi-arch manifest-list digest of ubuntu:24.04);
# - the builder stage owns the compilers and dev headers, the runtime
#   stage ships neither;
# - the venv installs the RUNTIME lock only, in hash-checking mode —
#   the old single lock put ruff, mypy and pytest in every production
#   image — and nothing is upgraded outside the lock any more (pip
#   stays as ensurepip provides it; setuptools is pinned in-lock).
FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV APP_HOME=/home/alirpunkto/app
ENV VENV_DIR=/home/alirpunkto/venv

# Compilers and headers live here only: today every locked dependency
# ships a wheel, but a future lock bump may bring an sdist back.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    python3 \
    python3-dev \
    python3-venv \
    libjpeg-dev \
    libldap2-dev \
    libsasl2-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    libz-dev \
    libfreetype6-dev \
    libtiff-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv "${VENV_DIR}"

WORKDIR ${APP_HOME}

# Lock first, sources after: dependency layers are rebuilt only when
# the lock changes.
COPY requirements.lock ${APP_HOME}/requirements.lock
RUN "${VENV_DIR}/bin/pip" install --no-cache-dir --require-hashes -r requirements.lock

COPY . ${APP_HOME}
# --no-build-isolation: the editable build uses the venv's pinned
# setuptools (>=70.1, so no separate wheel package) instead of
# downloading an unpinned toolchain during the build.
RUN "${VENV_DIR}/bin/pip" install --no-cache-dir --no-build-isolation --no-deps -e .

# ── Runtime stage ─────────────────────────────────────────────────────
FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Optional build-time switch to include extra debugging tools.
ARG BUILD_WITH_DEBUG=0
ENV BUILD_WITH_DEBUG=${BUILD_WITH_DEBUG}
ENV APP_HOME=/home/alirpunkto/app
ENV VENV_DIR=/home/alirpunkto/venv

# No compiler, no dev headers: the locked set installs from wheels,
# which bundle their native libraries.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    && if [ "$BUILD_WITH_DEBUG" = "1" ]; then \
        apt-get install -y --no-install-recommends vim dnsutils iputils-ping net-tools telnet; \
    fi \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1001 alirpunkto \
    && useradd -m -u 1001 -g 1001 -s /bin/bash alirpunkto

COPY --from=builder --chown=1001:1001 ${VENV_DIR} ${VENV_DIR}

WORKDIR ${APP_HOME}

COPY --chown=1001:1001 . ${APP_HOME}
COPY docker/start_pyramid.sh /usr/local/bin/start_pyramid.sh

RUN chmod +x /usr/local/bin/start_pyramid.sh \
    && mkdir -p ${APP_HOME}/var/log ${APP_HOME}/var/datas ${APP_HOME}/var/filestorage ${APP_HOME}/var/sessions \
    && chown -R alirpunkto:alirpunkto ${APP_HOME}/var /usr/local/bin/start_pyramid.sh

# Persist application state and uploaded/generated files.
VOLUME ["/home/alirpunkto/app/var"]

# Run the app as the dedicated non-root user.
USER alirpunkto

# Expose the Waitress port used by `production.ini`.
EXPOSE 6543

# Start Pyramid through the custom entrypoint.
ENTRYPOINT ["/usr/local/bin/start_pyramid.sh"]

# Default to the production configuration file.
CMD ["production.ini"]
